DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 開発者モードでコピーしたサーバーID。このサーバー内だけで動作します。
DISCORD_GUILD_ID=
DATA_DIR=./data
MAX_RECORDING_MINUTES=120
MAX_RECORDING_MB=2048
# 未指定の場合は「サーバー管理」権限を持つ人だけ開始できます。
ALLOWED_ROLE_ID=
# PC内での文字起こし。日本語対応モデル: tiny / base / small / medium / large-v3
WHISPER_MODEL=small
TRANSCRIBE_LANGUAGE=ja
PYTHON_PATH=./.venv/bin/python
CODEX_PATH=codex
# 空欄ならCodexの標準モデルを使います。
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=600

# 議事録・文字起こしの送信先テキストチャンネルID。空欄なら録音したVCのチャット。
DISCORD_OUTPUT_CHANNEL_ID=
